# Шаблон для файла .env на сервере, рядом с docker-compose.prod.yml.
# Настоящий .env на сервер не коммитится и переносится вручную: chmod 600.

# Прямое подключение Neon (без -pooler в имени хоста): Flyway берёт блокировку
# миграции через advisory lock, а пул в transaction mode её не удержит.
# sslmode=require обязателен — Neon отвергает незашифрованные соединения.
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-XXXX.REGION.neon.tech:5432/splitly?sslmode=require

SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Ключ подписи JWT. На проде обязан отличаться от локального.
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=
