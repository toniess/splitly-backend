# Caddy сам получает и продлевает сертификат Let's Encrypt.
# Условие: домен уже указывает на этот сервер, а порты 80 и 443 открыты —
# подтверждение владения доменом приходит по HTTP на 80-й.

{
	# Сюда придёт письмо, если с продлением сертификата что-то пойдёт не так.
	email ВПИШИ_СВОЙ_EMAIL
}

api.toniess.dev {
	encode gzip

	# Caddy проставляет X-Forwarded-Proto и X-Forwarded-For; приложение читает их,
	# потому что в application-prod.yml включён forward-headers-strategy.
	reverse_proxy app:8080

	log {
		output stdout
		format json
	}
}
