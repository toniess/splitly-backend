# Всё перечисленное не попадёт в контекст сборки — Docker не станет
# передавать это демону, и COPY его не увидит.

# Секреты. Самое важное в этом файле.
.env

# Результаты локальной сборки: внутри образа всё собирается заново,
# а весят они сотни мегабайт.
build/
.gradle/

# История репозитория приложению не нужна.
.git/
.gitignore

# Среда разработки.
.idea/
*.iml
.vscode/

# Прочее
*.md
docker-compose.yml
Dockerfile
.DS_Store
